# Copien este archivo como mexico_vivo/.env y pongan su propia API key de AI Studio.
# NUNCA suban el .env (ya está en .gitignore).
GOOGLE_API_KEY=tu_api_key

# Modelo por defecto de todos los agentes
AGENT_MODEL=gemini-3.5-flash-lite

# Opcional: modelo por rol (útil para el "un cambio" de los evals)
# MODEL_EVALUADOR=
# MODEL_EXPERTO=
# MODEL_CONTACTADOR=

# Bases de datos (relativas a la raíz del repo)
FUNDACION_DB=datos/fundacion.db
PUBLICOS_DB=datos/publicos.db

# RAG: "local" (multilingual-e5-small, sin cuota) o "gemini"
EMBEDDINGS=local
CHROMA_DIR=chroma_db
